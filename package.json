{
  "name": "infinite-canvas",
  "private": true,
  "description": "An infinite canvas tutorial",
  "keywords": [
    "infinite canvas",
    "tutorial",
    "webgl",
    "webgpu"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoiver/infinite-canvas"
  },
  "license": "MIT",
  "author": {
    "name": "xiaoiver",
    "url": "https://github.com/xiaoiver"
  },
  "scripts": {
    "clean": "rimraf dist",
    "lint-staged": "lint-staged",
    "prepare": "husky install",
    "build": "bun run --filter '*' build",
    "deploy": "npx wrangler pages deploy ./packages/site/docs/.vitepress/dist",
    "cov": "jest --coverage",
    "test:ecs": "jest -c ./jest.ecs.config.js --coverage",
    "test:e2e": "npx playwright test",
    "dev:e2e": "vite dev",
    "test:ui": "npx playwright test -c playwright.config.ui.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish --tag latest",
    "release:alpha": "changeset publish --tag alpha"
  },
  "workspaces": [
    "packages/ecs",
    "packages/webcomponents",
    "packages/plugin-*",
    "__tests__/*"
  ],
  "overrides": {
    "esbuild": "0.23.1",
    "playwright": "1.49.1",
    "rollup": "4.44.0",
    "lodash-es": "4.17.23"
  },
  "devDependencies": {
    "@antv/g-device-api": "^1.6.13",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "18.0.0",
    "@eslint/js": "^9.39.2",
    "@loaders.gl/core": "^4.3.4",
    "@loaders.gl/images": "^4.3.4",
    "@playwright/test": "^1.58.2",
    "@sand4rt/experimental-ct-web": "^1.58.2",
    "@types/gl": "^6.0.5",
    "@types/jest": "^26.0.24",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vue-macros/eslint-config": "^0.7.1",
    "@xmldom/xmldom": "^0.9.8",
    "canvas": "^3.2.1",
    "case-police": "^0.5.14",
    "eslint": "^9.39.2",
    "eslint-plugin-jest": "24.3.6",
    "get-pixels": "3.3.3",
    "gl": "^6.0.2",
    "globals": "^16.5.0",
    "grapheme-splitter": "^1.0.4",
    "husky": "^7.0.4",
    "jest": "^29.7.0",
    "jsdom": "^27.4.0",
    "lint-staged": "^10.5.4",
    "markdownlint-cli": "^0.32.2",
    "npm-run-all": "^4.1.5",
    "pixelmatch": "5.3.0",
    "pngjs": "^6.0.0",
    "pngparse-sync": "^1.0.2",
    "prettier": "^2.8.8",
    "rimraf": "^4.4.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vue-eslint-parser": "^9.4.3"
  },
  "lint-staged": {
    "*.{md,json}": [
      "prettier --write"
    ],
    "*.md": [
      "markdownlint --fix",
      "case-police --fix",
      "prettier --write"
    ],
    "*.{js,jsx,tsx,ts,vue}": [
      "eslint --fix"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
