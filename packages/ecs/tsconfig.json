{
  "extends": "../../tsconfig.json",
  "include": ["src/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "src/**/*.js"],
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false,
    "rootDir": "./src",
    "typeRoots": ["./types"]
  }
}

