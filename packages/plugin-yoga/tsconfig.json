{
  "extends": "../../tsconfig.json",
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ],
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false,
    "module": "ESNext",
    "baseUrl": ".",
    "paths": {
      "yoga-layout/load": ["./node_modules/yoga-layout/dist/src/load"]
    },
  }
}
